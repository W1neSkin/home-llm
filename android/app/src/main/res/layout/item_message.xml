<?xml version="1.0" encoding="utf-8"?>
<!-- Ответ — обычный текст, его можно выделить пальцем. Иконка под ним копирует целиком. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="2dp">

    <!-- Строка свёрнута. Пока мысль пишется, рядом крутится значок. -->
    <LinearLayout
        android:id="@+id/thoughtLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/thoughtSpin"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:indeterminateTint="#C8C8C8"
            android:visibility="gone" />

        <TextView
            android:id="@+id/thoughtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▸  Размышление"
            android:textColor="#9A9A9A"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Серый текст мысли. Над ответом, чтобы его было видно сразу. -->
    <TextView
        android:id="@+id/thought"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingBottom="10dp"
        android:textColor="#C8C8C8"
        android:textColorHighlight="#66FFFFFF"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:textColor="#F2F2F2"
        android:textColorHighlight="#66FFFFFF"
        android:textIsSelectable="true"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/copy"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_icon"
        android:contentDescription="Скопировать весь ответ"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_copy" />
</LinearLayout>
