# Файл в папке models или имя модели на ollama.com.
# Сменить: положить новый .gguf в models и запустить scripts\update-model.ps1 -Base <файл>
BASE_MODEL=Huihui-Qwen3.8-27B-abliterated-UD-Q3_K_XL.gguf

# Сколько токенов помнить. 8192 нормально для видеокарты 16 ГБ.
NUM_CTX=16384

# Имя, которое видно в чате. Его лучше не менять: история не оторвётся от модели.
MODEL=home-qwen

# Порт сайта в домашней сети. Сама модель снаружи не открыта.
WEBUI_PORT=8787

# true: у каждого человека свой вход и свои чаты.
# Логин выглядит как почта, но письма никуда не уходят. Пример: dima@home.local
WEBUI_AUTH=true
ENABLE_SIGNUP=true

# Ключ приложения на телефоне. Его показывает пункт «Адрес для других» у значка.
PHONE_PORT=8765
PHONE_TOKEN=

# Telegram. Пока токен пустой, бот не запускается.
# Токен выдаёт @BotFather. Свой числовой id показывает @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
