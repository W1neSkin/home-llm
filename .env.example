# Базовая модель с ollama.com. Сменить: scripts\update-model.ps1 -Base <имя>
# qwen3:8b-q8_0 — почти полная Qwen3 8B, около 9 ГБ, нормально для 16 ГБ видеокарты.
# qwen3:8b — та же модель, квант Q4, около 5 ГБ, быстрее и легче для видеокарты.
BASE_MODEL=qwen3:8b-q8_0

# Имя, которое видно в чате. Его лучше не менять: история не оторвётся от модели.
MODEL=home-qwen

# Порт сайта в домашней сети. Сама модель снаружи не открыта.
WEBUI_PORT=8080

# Первый заход создаёт администратора. После этого поставьте false и выполните
# docker compose up -d, чтобы сосед по Wi-Fi не завёл себе аккаунт.
ENABLE_SIGNUP=true

# Telegram. Пока токен пустой, бот не запускается.
# Токен выдаёт @BotFather. Свой числовой id показывает @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
